{
  "builds": [
    { "src": "contest_server.py",              "use": "@vercel/python" },
    { "src": "api/auth_login.py",              "use": "@vercel/python" },
    { "src": "api/auth_signup.py",             "use": "@vercel/python" },
    { "src": "api/auth_me.py",                 "use": "@vercel/python" },
    { "src": "api/auth_reset_request.py",      "use": "@vercel/python" },
    { "src": "api/auth_reset_confirm.py",      "use": "@vercel/python" },
    { "src": "api/auth_change_password.py",    "use": "@vercel/python" },
    { "src": "api/progress_handler.py",        "use": "@vercel/python" },
    { "src": "api/contest_data_api.py",        "use": "@vercel/python" },
    { "src": "api/skilltree2_progress.py",     "use": "@vercel/python" },
    { "src": "api/upsolve_data.py",            "use": "@vercel/python" },
    { "src": "index.html",                     "use": "@vercel/static" },
    { "src": "app.js",                         "use": "@vercel/static" },
    { "src": "auth-gate.js",                   "use": "@vercel/static" },
    { "src": "styles.css",                     "use": "@vercel/static" },
    { "src": "progress.json",                  "use": "@vercel/static" },
    { "src": "skilltree-progress-2025-11-26.json", "use": "@vercel/static" },
    { "src": "reset-password.html",            "use": "@vercel/static" },
    { "src": "contest/**",                     "use": "@vercel/static" },
    { "src": "A2OJ/**",                        "use": "@vercel/static" },
    { "src": "analysis/**",                    "use": "@vercel/static" },
    { "src": "codeforces/**",                  "use": "@vercel/static" },
    { "src": "skilltree2/**",                  "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth/login",           "dest": "api/auth_login.py" },
    { "src": "/api/auth/signup",          "dest": "api/auth_signup.py" },
    { "src": "/api/auth/me",              "dest": "api/auth_me.py" },
    { "src": "/api/auth/reset-request",   "dest": "api/auth_reset_request.py" },
    { "src": "/api/auth/reset-confirm",   "dest": "api/auth_reset_confirm.py" },
    { "src": "/api/auth/change-password", "dest": "api/auth_change_password.py" },
    { "src": "/api/health",               "dest": "contest_server.py" },
    { "src": "/api/contest/data",         "dest": "api/contest_data_api.py" },
    { "src": "/api/contest/(.*)",         "dest": "contest_server.py" },
    { "src": "/progress",                 "dest": "api/progress_handler.py" },
    { "src": "/api/progress",             "dest": "api/progress_handler.py" },
    { "src": "/api/contest-data",         "dest": "api/contest_data_api.py" },
    { "src": "/api/skilltree2-progress",  "dest": "api/skilltree2_progress.py" },
    { "src": "/api/upsolve-data",         "dest": "api/upsolve_data.py" },
    { "src": "/(.*)",                     "dest": "/$1" }
  ]
}
