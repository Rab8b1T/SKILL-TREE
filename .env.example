# Copy to .env.local, or pull the real values with `vercel env pull .env.local`.

# ---------------------------------------------------------------------------
# Required — MongoDB. Two clusters, inherited from the previous deployment.
# ---------------------------------------------------------------------------
# App data: virtual contests, practice lists, upsolve queue, ladder progress.
# Documents are keyed by _id = <codeforces handle>.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=skilltree

# Accounts only: username, password hash, reset token.
USER_MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
USER_DB_NAME=user

# ---------------------------------------------------------------------------
# Required — auth
# ---------------------------------------------------------------------------
# Signs the session JWT (HS256). Rotating it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# Optional — password reset email. Without these, /api/auth/reset-request
# still returns 200 (it never reveals whether an account exists) but no mail
# is sent, so the reset link never arrives.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESET_FROM_EMAIL=Skill Tree <onboarding@resend.dev>

# Base URL used to build the reset link. Falls back to the request origin,
# which is right locally and on Vercel previews.
APP_URL=http://localhost:3000
